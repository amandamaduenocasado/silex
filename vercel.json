{
	"projects": {},
	"builds": [
		{
			"src": "client/vite.config.js",
			"use": "@vercel/static-build",
			"config": {
				"distDir": "client/dist"
			}
		},
		{
			"src": "server/index.js",
			"use": "@vercel/node"
		}
	],
	"routes": [
		{
			"src": "/api/(.*)",
			"dest": "server/index.js"
		},
		{
			"src": "/(.*)",
			"dest": "client/index.html"
		}
	]
}
